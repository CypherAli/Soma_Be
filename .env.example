# Soma 3D Backend — sao chép thành .env và điền giá trị thật
# PostgreSQL (local hoặc Render). Prisma 7 dùng driver adapter (@prisma/adapter-pg).
DATABASE_URL="postgresql://user:password@localhost:5432/soma3d?schema=public"

# Cổng API (mặc định 4000)
PORT=4000
API_URL=http://localhost:4000/api
FRONTEND_URL=http://localhost:3000

# OAuth (xem .env.oauth.example) — Google / GitHub / Facebook Client ID + Secret
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=

# SMTP gửi email đặt lại mật khẩu — FREE 100% bằng Gmail App Password:
# 1. Bật 2-Step Verification cho Gmail
# 2. Vào https://myaccount.google.com/apppasswords tạo App password 16 ký tự
# 3. Điền vào đây. Không cấu hình thì BE vẫn chạy, nhưng API quên mật khẩu trả lỗi dịch vụ.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
SMTP_FROM=Soma 3D <you@gmail.com>
