API_URL=http://localhost:4000/api
FRONTEND_URL=http://localhost:3000
# HTTPS API reachable from phones. Add its three callback URLs in the provider consoles.
# Keep API_URL above unchanged to preserve the local web login callbacks.
MOBILE_OAUTH_API_URL=
# Expo Go: register the exact address shown by npm run dev. APK uses soma://oauth by default.
# Multiple allowed Expo/browser return URLs are separated by commas. No wildcard hosts.
MOBILE_OAUTH_RETURN_URLS=exp://192.168.100.35:8081/--/oauth
# Optional dedicated mobile credentials; default uses the same clients as web.
MOBILE_GITHUB_CLIENT_ID=
MOBILE_GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
