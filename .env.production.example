# Template only. Set real values as hosting secrets; do not commit a filled file.
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@DATABASE_HOST:5432/soma3d?schema=public
PORT=4000
API_URL=https://API_HOST/api
FRONTEND_URL=https://WEB_HOST
MOBILE_OAUTH_API_URL=https://API_HOST/api
# Installed APK uses soma://oauth automatically. Add exact Expo URLs only while testing.
MOBILE_OAUTH_RETURN_URLS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Optional separate GitHub OAuth app for the mobile HTTPS callback.
MOBILE_GITHUB_CLIENT_ID=
MOBILE_GITHUB_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Keep payments disabled until its separate production acceptance is complete.
SEPAY_PG_ENABLED=false

# Internal frontend origin for the shared assistant API (never a client-controlled URL).
MOBILE_WEB_URL=http://fe:3000
