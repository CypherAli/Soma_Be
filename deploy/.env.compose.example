# Đặt cạnh docker-compose.yml thành file `.env` rồi điền giá trị thật.
# Bỏ trống thì stack vẫn chạy, nhưng trợ lý AI chỉ tra cứu nguyên văn,
# Vision AI chỉ còn tầng MediaPipe offline; email reset không hoạt động nếu chưa cấu hình SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Soma 3D <you@gmail.com>
