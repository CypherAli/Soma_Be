# Đặt cạnh docker-compose.yml thành file `.env` rồi điền giá trị thật.
# Bỏ trống thì stack vẫn chạy, nhưng trợ lý AI chỉ tra cứu nguyên văn,
# Vision AI chỉ còn tầng MediaPipe offline; email reset không hoạt động nếu chưa cấu hình SMTP.
SMTP_HOST=smtp.gmail.com
# Địa chỉ trình duyệt truy cập được. Đổi các giá trị này cần build lại FE/BO.
PUBLIC_API_URL=http://localhost:4000/api
PUBLIC_SITE_URL=http://localhost:3000
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Soma 3D <you@gmail.com>
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AI_API_KEY=
# AI_BASE_URL=
# AI_MODEL=
# SOMA_VISION_URL=
# SOMA_VISION_KEY=
