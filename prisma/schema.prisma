// Soma 3D — Backend data model
// Đa ngữ: mỗi tên có 3 cột vi/en/zh + tên Latin (chuẩn TA2).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Loài: người, chó, mèo... (mở rộng sang thú y)
model Species {
  id     String  @id @default(cuid())
  code   String  @unique // "human", "canine", "feline"
  nameVi String
  nameEn String
  nameZh String
  latin  String? // Homo sapiens, Canis familiaris...

  systems    AnatomySystem[]
  structures Structure[]

  @@map("species")
}

/// Hệ cơ quan (xương, cơ, thần kinh...)
model AnatomySystem {
  id     String  @id @default(cuid())
  code   String  @unique // "skeletal", "muscular"...
  nameVi String
  nameEn String
  nameZh String
  latin  String?
  order  Int     @default(0)

  speciesId String
  species   Species @relation(fields: [speciesId], references: [id])

  structures Structure[]
  quizzes    QuizQuestion[]

  @@map("anatomy_systems")
}

/// Cấu trúc giải phẫu — có phân cấp cha/con, gắn với mesh trong model glTF.
model Structure {
  id            String  @id @default(cuid())
  code          String  @unique
  meshName      String? // tên mesh trong file glTF (khớp Z-Anatomy)
  nameVi        String
  nameEn        String
  nameZh        String
  latin         String? // tên Latin theo TA2
  taCode        String? // mã Terminologia Anatomica
  descriptionVi String? @db.Text
  descriptionEn String? @db.Text
  descriptionZh String? @db.Text

  systemId String
  system   AnatomySystem @relation(fields: [systemId], references: [id])

  speciesId String
  species   Species @relation(fields: [speciesId], references: [id])

  parentId String?
  parent   Structure?  @relation("StructureTree", fields: [parentId], references: [id])
  children Structure[] @relation("StructureTree")

  pathologies Pathology[]

  @@index([systemId])
  @@index([parentId])
  @@map("structures")
}

/// Bệnh lý gắn vào cấu trúc — luôn kèm nguồn trích dẫn.
model Pathology {
  id            String  @id @default(cuid())
  nameVi        String
  nameEn        String
  nameZh        String
  latin         String?
  icdCode       String? // ICD-11
  severity      String? // "info" | "warning" | "critical"
  descriptionVi String? @db.Text
  source        String // Gray's Anatomy 42e, Braunwald's...

  structureId String
  structure   Structure @relation(fields: [structureId], references: [id])
  citations   PathologyCitation[]

  @@index([structureId])
  @@map("pathologies")
}

/// Câu hỏi trắc nghiệm theo hệ cơ quan.
model QuizQuestion {
  id          String  @id @default(cuid())
  promptVi    String  @db.Text
  promptEn    String  @db.Text
  promptZh    String  @db.Text
  explanation String? @db.Text
  source      String? // nguồn y khoa

  systemId String
  system   AnatomySystem @relation(fields: [systemId], references: [id])

  options QuizOption[]

  @@index([systemId])
  @@map("quiz_questions")
}

model QuizOption {
  id        String  @id @default(cuid())
  textVi    String
  textEn    String
  textZh    String
  latin     String?
  isCorrect Boolean @default(false)

  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("quiz_options")
}

/// Bộ sưu tập chuyên gia (Expert Collections trên trang home).
model Collection {
  id         String  @id @default(cuid())
  titleVi    String
  titleEn    String
  titleZh    String
  authorName String?
  authorRole String?
  isPremium  Boolean @default(false)
  coverColor String? // màu footer card: blue/purple/teal
  order      Int     @default(0)

  @@map("collections")
}

/// Tài liệu y khoa được phép sử dụng, quản lý độc lập với bệnh lý.
model MedicalSource {
  id          String @id
  title       String
  publisher   String
  year        Int?
  url         String
  localFile   String?
  status      String
  licenseNote String? @db.Text
  checkedAt   DateTime @default(now())
  citations   PathologyCitation[]

  @@map("medical_sources")
}

/// Một bệnh có thể có nhiều trích dẫn; luôn lưu trang/mục để kiểm chứng.
model PathologyCitation {
  id            String @id @default(cuid())
  pathologyId   String
  pathology     Pathology @relation(fields: [pathologyId], references: [id], onDelete: Cascade)
  sourceId      String
  source        MedicalSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  pageOrSection String?
  quote         String? @db.Text
  verified      Boolean @default(false)
  verifiedBy    String?
  verifiedAt    DateTime?

  @@unique([pathologyId, sourceId, pageOrSection])
  @@index([pathologyId])
  @@index([sourceId])
  @@map("pathology_citations")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  githubId     String?  @unique
  facebookId   String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sessions     Session[]

  @@map("users")
  quizAttempts QuizAttempt[]
  studyPath    StudyPath?
  reviewItems  ReviewItem[]
  personalDocs PersonalDoc[]
}

model OAuthState {
  id           String   @id @default(cuid())
  stateHash    String   @unique
  provider     String
  codeVerifier String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  @@index([expiresAt])
  @@map("oauth_states")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Một lượt làm bài ĐÃ NỘP.
///
/// Đây là dữ liệu duy nhất nói được người học yếu ở đâu, nên nó gắn theo TÀI
/// KHOẢN chứ không theo trình duyệt — cùng lý do với [ChatMemory]. Chưa đăng
/// nhập thì phía web tự lùi về localStorage, không ép phải có tài khoản mới
/// làm được bài.
model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// model | book | atlas | personal
  source    String
  /// mã hệ cơ quan, tên vùng cơ thể, hoặc "all"
  scope     String   @default("all")
  /// practice | exam
  mode      String   @default("practice")
  score     Int
  total     Int
  /// số giây thực làm, 0 khi không đo được
  seconds   Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("quiz_attempts")
}

/// Lộ trình học đang hoạt động — mỗi tài khoản đúng MỘT lộ trình.
///
/// Không lưu lịch cứng từng ngày: người học nghỉ hai hôm là lịch cứng sai hết
/// và chỉ tổ làm người ta bỏ. Lộ trình chỉ giữ mục tiêu và nhịp; buổi học hôm
/// nay được tính ra từ [ReviewItem] đến hạn tại thời điểm mở trang.
model StudyPath {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal          String
  daysPerWeek   Int      @default(4)
  minutesPerDay Int      @default(25)
  /// hệ ưu tiên, hoặc "all"
  systemKey     String   @default("all")
  /// độ dài quãng học người dùng đặt ra: 7 = một tuần, 28 = một tháng, 365 = một năm
  horizonDays   Int      @default(28)
  /// mốc gốc để đổi khối của dàn bài thành ngày lịch thật
  startedAt     DateTime @default(now())
  /// thứ tự hệ cơ quan muốn học, ví dụ ["nervous","visceral"]; rỗng thì học đều
  focusSystems  String[] @default([])
  brief         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("study_paths")
}

/// Một cấu trúc / câu hỏi trong hàng đợi ôn theo khoảng cách (SM-2 rút gọn).
///
/// Trả lời đúng thì giãn khoảng cách ra, sai thì kéo về ôn lại ngay hôm sau.
/// Nhờ vậy "buổi học hôm nay" luôn tính được, không cần lịch cố định.
model ReviewItem {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// khoá ổn định của câu: "model:<factId>", "book:<qid>", "atlas:<id>", "personal:<id>"
  itemKey      String
  source       String
  scope        String   @default("all")
  /// hệ số dễ SM-2; càng thấp càng phải gặp lại nhiều
  ease         Float    @default(2.5)
  intervalDays Int      @default(0)
  reps         Int      @default(0)
  lapses       Int      @default(0)
  dueAt        DateTime @default(now())
  lastAt       DateTime @default(now())

  @@unique([userId, itemKey])
  @@index([userId, dueAt])
  @@map("review_items")
}

/// Tài liệu PDF người dùng tải lên để tạo bộ đề riêng.
///
/// CHỈ lưu phần kê khai và các câu bóc được — KHÔNG lưu lại tệp PDF gốc. Trang
/// web hứa "chỉ tài khoản của bạn truy cập", mà cách chắc chắn nhất để giữ lời
/// hứa đó là máy chủ không giữ bản sao tài liệu sau khi bóc xong.
model PersonalDoc {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename  String
  bytes     Int
  pages     Int      @default(0)
  /// processing | ready | failed
  status    String   @default("processing")
  note      String?  @db.Text
  createdAt DateTime @default(now())
  questions PersonalQuestion[]

  @@index([userId, createdAt])
  @@map("personal_docs")
}

/// Một câu bóc ra từ tài liệu cá nhân, mặc định CHỜ DUYỆT.
///
/// Máy bóc đề từ PDF không bao giờ đúng hết. Câu chưa được người tải lên duyệt
/// thì không được đem ra hỏi — sai một dấu trong câu giải phẫu là học sai luôn.
model PersonalQuestion {
  id          String  @id @default(cuid())
  docId       String
  doc         PersonalDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  userId      String
  stem        String  @db.Text
  /// { "A": "...", "B": "..." } — giữ nguyên nhãn chữ cái của tài liệu gốc
  options     Json
  answer      String
  explanation String? @db.Text
  page        Int?
  approved    Boolean @default(false)
  /// "parser" = bộ luật bóc ra, "ai" = mô hình ngôn ngữ đọc hộ khi bộ luật bó tay
  origin      String  @default("parser")

  @@index([userId, approved])
  @@index([docId])
  @@map("personal_questions")
}
