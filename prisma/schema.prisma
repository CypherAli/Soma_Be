// Soma 3D — Backend data model
// Đa ngữ: mỗi tên có 3 cột vi/en/zh + tên Latin (chuẩn TA2).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Public website content. Drafts never appear in the public content endpoint.
model SiteContent {
  id          String   @id
  draft       Json
  published   Json?
  version     Int      @default(1)
  publishedAt DateTime?
  updatedAt   DateTime @updatedAt
  revisions   SiteContentRevision[]

  @@map("site_content")
}

model SiteContentRevision {
  id         String      @id @default(cuid())
  contentId  String
  content    SiteContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  version    Int
  payload    Json
  action     String
  actorEmail String
  createdAt  DateTime    @default(now())

  @@unique([contentId, version])
  @@map("site_content_revisions")
}

model SiteContentPreview {
  tokenHash String   @id
  payload   Json
  expiresAt DateTime

  @@index([expiresAt])
  @@map("site_content_previews")
}

model SiteAsset {
  id        String   @id
  filename  String
  mime      String
  bytes     Int
  data      Bytes
  meshNames Json
  createdAt DateTime @default(now())

  @@map("site_assets")
}

/// Loài: người, chó, mèo... (mở rộng sang thú y)
model Species {
  id     String  @id @default(cuid())
  code   String  @unique // "human", "canine", "feline"
  nameVi String
  nameEn String
  nameZh String
  latin  String? // Homo sapiens, Canis familiaris...

  systems    AnatomySystem[]
  structures Structure[]

  @@map("species")
}

/// Hệ cơ quan (xương, cơ, thần kinh...)
model AnatomySystem {
  id     String  @id @default(cuid())
  code   String  @unique // "skeletal", "muscular"...
  nameVi String
  nameEn String
  nameZh String
  latin  String?
  order  Int     @default(0)

  speciesId String
  species   Species @relation(fields: [speciesId], references: [id])

  structures Structure[]
  quizzes    QuizQuestion[]

  @@map("anatomy_systems")
}

/// Cấu trúc giải phẫu — có phân cấp cha/con, gắn với mesh trong model glTF.
model Structure {
  id            String  @id @default(cuid())
  code          String  @unique
  meshName      String? // tên mesh trong file glTF (khớp Z-Anatomy)
  nameVi        String
  nameEn        String
  nameZh        String
  latin         String? // tên Latin theo TA2
  taCode        String? // mã Terminologia Anatomica
  descriptionVi String? @db.Text
  descriptionEn String? @db.Text
  descriptionZh String? @db.Text

  systemId String
  system   AnatomySystem @relation(fields: [systemId], references: [id])

  speciesId String
  species   Species @relation(fields: [speciesId], references: [id])

  parentId String?
  parent   Structure?  @relation("StructureTree", fields: [parentId], references: [id])
  children Structure[] @relation("StructureTree")

  pathologies        Pathology[]
  relatedPathologies PathologyStructure[]

  @@index([systemId])
  @@index([parentId])
  @@map("structures")
}

/// Mức độ ưu tiên hiển thị. Trước đây là String tự do nên dữ liệu nhập ngoài
/// API có thể mang giá trị sai; nay ràng buộc ở tầng cơ sở dữ liệu.
enum Severity {
  info
  warning
  critical
}

/// Bệnh lý — luôn kèm nguồn trích dẫn.
///
/// `structureId` ĐỂ RỖNG ĐƯỢC: 22 bệnh huyết học và hồi sức cấp cứu không thuộc
/// về một cấu trúc 3D đơn lẻ nào (sốc, rối loạn kali máu, ngộ độc cấp…). Trước
/// đây trường này bắt buộc nên những bệnh đó không thể nhập vào.
/// Cấu trúc phụ đi qua `relatedStructures` vì nhiều bệnh tổn thương đa cơ quan.
model Pathology {
  id       String  @id @default(cuid())
  slug     String  @unique
  nameVi   String
  nameEn   String
  nameZh   String
  latin    String?
  icdCode  String? // ICD-11 — để trống nếu chưa tra được từ nguồn chính thức
  severity Severity?

  /// Hệ lâm sàng theo giáo trình (Hô hấp, Tim mạch…), khác với hệ giải phẫu.
  clinicalSystem String?

  source     String
  sourcePage Int?

  /// true = metadata máy dựng từ mục lục, nội dung y khoa chưa có người duyệt.
  needsReview Boolean @default(true)

  structureId String?
  structure   Structure? @relation(fields: [structureId], references: [id])

  /// Tên mesh glTF của ĐÚNG vị trí tổn thương, trong model TOÀN THÂN mà
  /// /viewer nạp (skeletal/muscular/nervous/cardiovascular/visceral/
  /// lymphoid/joints) — KHÔNG phải model theo scene.
  /// Chỉ đặt khi có mesh tương ứng thật và đúng về giải phẫu; bệnh lan toả
  /// (xơ gan, COPD) để trống thay vì neo bừa vào một phần cơ quan.
  /// Kiểm bằng: cd Soma_Fe && npm run verify:lesions
  lesionMesh   String?
  /// Hệ phải bật để mesh trên hiện ra trong viewer.
  lesionSystem String?

  relatedStructures PathologyStructure[]
  content           PathologyContent[]
  citations         PathologyCitation[]

  @@index([structureId])
  @@index([clinicalSystem])
  @@map("pathologies")
}

/// Cấu trúc phụ mà bệnh còn ảnh hưởng tới (lupus, suy tim, đái tháo đường…).
model PathologyStructure {
  pathologyId String
  pathology   Pathology @relation(fields: [pathologyId], references: [id], onDelete: Cascade)
  structureId String
  structure   Structure @relation(fields: [structureId], references: [id], onDelete: Cascade)

  @@id([pathologyId, structureId])
  @@index([structureId])
  @@map("pathology_structures")
}

/// Nội dung bệnh học tách theo ngôn ngữ — tránh phình 15 cột trên `pathologies`
/// và cho phép thêm ngôn ngữ mà không cần migration.
model PathologyContent {
  id          String @id @default(cuid())
  pathologyId String
  pathology   Pathology @relation(fields: [pathologyId], references: [id], onDelete: Cascade)
  locale      String // vi | en | zh

  description String? @db.Text
  clinical    String? @db.Text // lâm sàng & cận lâm sàng
  imaging     String? @db.Text // chẩn đoán hình ảnh
  progression String? @db.Text // tiến triển & biến chứng
  treatment   String? @db.Text // điều trị tham khảo

  /// true = bản dịch do máy sinh, CHƯA có người chuyên môn duyệt.
  /// Bản tiếng Việt gốc soạn tay nên luôn false. Cờ này đi thẳng ra giao diện:
  /// người đọc phải biết mình đang đọc bản dịch máy, không được giấu.
  machineTranslated Boolean @default(false)

  @@unique([pathologyId, locale])
  @@index([pathologyId])
  @@map("pathology_content")
}

/// Câu hỏi trắc nghiệm theo hệ cơ quan.
model QuizQuestion {
  id          String  @id @default(cuid())
  promptVi    String  @db.Text
  promptEn    String  @db.Text
  promptZh    String  @db.Text
  explanation String? @db.Text
  source      String? // nguồn y khoa

  systemId String
  system   AnatomySystem @relation(fields: [systemId], references: [id])

  options QuizOption[]

  @@index([systemId])
  @@map("quiz_questions")
}

model QuizOption {
  id        String  @id @default(cuid())
  textVi    String
  textEn    String
  textZh    String
  latin     String?
  isCorrect Boolean @default(false)

  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("quiz_options")
}


/// Tài liệu y khoa được phép sử dụng, quản lý độc lập với bệnh lý.
model MedicalSource {
  id          String @id
  title       String
  publisher   String
  year        Int?
  url         String
  localFile   String?
  status      String
  licenseNote String? @db.Text
  checkedAt   DateTime @default(now())
  citations   PathologyCitation[]

  @@map("medical_sources")
}

/// Một bệnh có thể có nhiều trích dẫn; luôn lưu trang/mục để kiểm chứng.
model PathologyCitation {
  id            String @id @default(cuid())
  pathologyId   String
  pathology     Pathology @relation(fields: [pathologyId], references: [id], onDelete: Cascade)
  sourceId      String
  source        MedicalSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  pageOrSection String?
  quote         String? @db.Text
  verified      Boolean @default(false)
  verifiedBy    String?
  verifiedAt    DateTime?

  @@unique([pathologyId, sourceId, pageOrSection])
  @@index([pathologyId])
  @@index([sourceId])
  @@map("pathology_citations")
}

/// Quyền trên trang quản trị, xếp từ thấp lên cao.
///
/// Cố ý KHÔNG dùng cờ boolean `isAdmin`: back office cần tách "người soạn nội
/// dung" khỏi "người đổi quyền của người khác", mà một cờ thì không nói được
/// điều đó. Bậc quyền so bằng thứ tự khai ở `ROLE_RANK` (auth/roles.ts).
enum UserRole {
  /// Người học bình thường — không vào được back office.
  user
  /// Soạn và sửa nội dung: bệnh lý, cấu trúc, hệ, quiz, nguồn.
  editor
  /// Thêm quyền kiểm duyệt và xem dữ liệu người dùng.
  admin
  /// Toàn quyền, kể cả cấp/thu quyền và xoá tài khoản.
  super_admin
}

/// Gói tài khoản. Chỉ ghi nhận trạng thái — mọi hạn mức (số câu hỏi cho trợ
/// lý, số tài liệu…) sẽ đọc trường này khi tính năng Pro được làm.
enum UserPlan {
  /// Gói thường, mặc định khi đăng ký.
  free
  /// Gói trả phí.
  pro
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String
  /// Only password sign-in owns this unique address. OAuth identities are independent.
  passwordEmail String? @unique
  role         UserRole @default(user)
  plan         UserPlan @default(free)
  /// Ảnh đại diện lưu THẲNG dưới dạng data URL (ảnh đã thu nhỏ ở trình duyệt,
  /// tối đa ~200 KB). Máy chủ chưa có nơi lưu tệp tĩnh nào, dựng thêm thư mục
  /// upload + đường phục vụ ảnh chỉ để nuôi một tấm avatar là không đáng.
  avatar       String?
  /// Khoá tài khoản: còn giữ lịch sử học nhưng không đăng nhập được nữa.
  /// Xoá hẳn là mất luôn dữ liệu tiến độ, nên khoá mới là hành động mặc định.
  disabledAt   DateTime?
  passwordHash String?
  googleId     String?  @unique
  githubId     String?  @unique
  facebookId   String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sessions     Session[]
  passwordResets PasswordResetToken[]
  chatMemory   ChatMemory?
  quizAttempts QuizAttempt[]
  studyPath    StudyPath?
  reviewItems  ReviewItem[]
  personalDocs PersonalDoc[]

  @@map("users")
  @@index([email])
}

model OAuthState {
  id           String   @id @default(cuid())
  stateHash    String   @unique
  provider     String
  codeVerifier String
  /// Mobile uses the same provider account, with a separate PKCE handoff.
  mobileChallenge String?
  mobileState String?
  callbackUrl String?
  /// Khác rỗng nghĩa là luồng "liên kết tài khoản đang đăng nhập" chứ không
  /// phải luồng đăng nhập: callback sẽ gắn id nhà cung cấp vào đúng người này.
  linkUserId   String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  @@index([expiresAt])
  @@map("oauth_states")
}

model MobileOAuthCode {
  codeHash String @id
  userId String
  challenge String
  expiresAt DateTime

  @@index([expiresAt])
  @@map("mobile_oauth_codes")
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  /// Chuỗi User-Agent lúc đăng nhập, để trang Bảo mật gọi tên được thiết bị.
  userAgent  String?
  /// Chỉ ghi lại khi đã cũ hơn 5 phút — cập nhật mỗi lần gọi API thì mỗi lần
  /// đọc dữ liệu lại kèm một lượt ghi.
  lastSeenAt DateTime @default(now())
  userId     String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Token đặt lại mật khẩu qua email: dùng một lần, hết hạn sau 15 phút.
/// Chỉ lưu hash SHA-256, token thật chỉ nằm trong link gửi qua email.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}


/// Bộ nhớ hội thoại của trợ lý, gắn theo TÀI KHOẢN chứ không theo trình duyệt.
/// Đăng nhập ở máy khác vẫn còn mạch hội thoại cũ. Chưa đăng nhập thì phía web
/// tự lùi về localStorage — không ép người dùng phải có tài khoản mới hỏi được.
model ChatMemory {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// [{ role: "user"|"bot", text: string }] — chỉ giữ số lượt gần nhất,
  /// cắt ở phía máy chủ để một tài khoản không phình vô hạn.
  turns Json @default("[]")

  updatedAt DateTime @updatedAt

  @@map("chat_memory")
}

/// Một lượt làm bài ĐÃ NỘP.
///
/// Đây là dữ liệu duy nhất nói được người học yếu ở đâu, nên nó gắn theo TÀI
/// KHOẢN chứ không theo trình duyệt — cùng lý do với [ChatMemory]. Chưa đăng
/// nhập thì phía web tự lùi về localStorage, không ép phải có tài khoản mới
/// làm được bài.
model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// model | book | atlas | personal | vet
  source    String
  /// mã hệ cơ quan, tên vùng cơ thể, hoặc "all"
  scope     String   @default("all")
  /// practice | exam
  mode      String   @default("practice")
  score     Int
  total     Int
  /// số giây thực làm, 0 khi không đo được
  seconds   Int      @default(0)
  /// Stable client UUID: retries after an ambiguous timeout return the same attempt.
  clientRequestId String?
  requestFingerprint String?
  createdAt DateTime @default(now())

  @@unique([userId, clientRequestId])
  @@index([userId, createdAt])
  @@map("quiz_attempts")
}

/// Lộ trình học đang hoạt động — mỗi tài khoản đúng MỘT lộ trình.
///
/// Không lưu lịch cứng từng ngày: người học nghỉ hai hôm là lịch cứng sai hết
/// và chỉ tổ làm người ta bỏ. Lộ trình chỉ giữ mục tiêu và nhịp; buổi học hôm
/// nay được tính ra từ [ReviewItem] đến hạn tại thời điểm mở trang.
model StudyPath {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal          String
  daysPerWeek   Int      @default(4)
  minutesPerDay Int      @default(25)
  /// hệ ưu tiên, hoặc "all"
  systemKey     String   @default("all")
  /// độ dài quãng học người dùng đặt ra: 7 = một tuần, 28 = một tháng, 365 = một năm
  horizonDays   Int      @default(28)
  /// mốc gốc để đổi khối của dàn bài thành ngày lịch thật
  startedAt     DateTime @default(now())
  /// thứ tự hệ cơ quan muốn học, ví dụ ["nervous","visceral"]; rỗng thì học đều
  focusSystems  String[] @default([])
  brief         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("study_paths")
}

/// Một cấu trúc / câu hỏi trong hàng đợi ôn theo khoảng cách (SM-2 rút gọn).
///
/// Trả lời đúng thì giãn khoảng cách ra, sai thì kéo về ôn lại ngay hôm sau.
/// Nhờ vậy "buổi học hôm nay" luôn tính được, không cần lịch cố định.
model ReviewItem {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// khoá ổn định của câu: "model:<factId>", "book:<qid>", "atlas:<id>", "personal:<id>", "vet:<factId>"
  itemKey      String
  source       String
  scope        String   @default("all")
  /// hệ số dễ SM-2; càng thấp càng phải gặp lại nhiều
  ease         Float    @default(2.5)
  intervalDays Int      @default(0)
  reps         Int      @default(0)
  lapses       Int      @default(0)
  dueAt        DateTime @default(now())
  lastAt       DateTime @default(now())

  @@unique([userId, itemKey])
  @@index([userId, dueAt])
  @@map("review_items")
}

/// Tài liệu PDF người dùng tải lên để tạo bộ đề riêng.
///
/// CHỈ lưu phần kê khai và các câu bóc được — KHÔNG lưu lại tệp PDF gốc. Trang
/// web hứa "chỉ tài khoản của bạn truy cập", mà cách chắc chắn nhất để giữ lời
/// hứa đó là máy chủ không giữ bản sao tài liệu sau khi bóc xong.
model PersonalDoc {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename  String
  bytes     Int
  pages     Int      @default(0)
  /// processing | ready | failed
  status    String   @default("processing")
  note      String?  @db.Text
  createdAt DateTime @default(now())
  questions PersonalQuestion[]

  @@index([userId, createdAt])
  @@map("personal_docs")
}

/// Một câu bóc ra từ tài liệu cá nhân, mặc định CHỜ DUYỆT.
///
/// Máy bóc đề từ PDF không bao giờ đúng hết. Câu chưa được người tải lên duyệt
/// thì không được đem ra hỏi — sai một dấu trong câu giải phẫu là học sai luôn.
model PersonalQuestion {
  id          String  @id @default(cuid())
  docId       String
  doc         PersonalDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  userId      String
  stem        String  @db.Text
  /// { "A": "...", "B": "..." } — giữ nguyên nhãn chữ cái của tài liệu gốc
  options     Json
  answer      String
  explanation String? @db.Text
  page        Int?
  approved    Boolean @default(false)
  /// "parser" = bộ luật bóc ra, "ai" = mô hình ngôn ngữ đọc hộ khi bộ luật bó tay
  origin      String  @default("parser")

  @@index([userId, approved])
  @@index([docId])
  @@map("personal_questions")
}

/// Nhật ký thao tác trên back office.
///
/// Nội dung y khoa mà ai sửa cũng được và không ai truy được là nội dung không
/// dùng được: có bệnh bị đổi liều thuốc thì phải biết ai đổi, đổi từ gì sang
/// gì. Ghi cả giá trị TRƯỚC khi sửa, vì bản ghi sau khi sửa thì đã nằm trong
/// chính bảng dữ liệu rồi — cái mất là bản cũ.
model AuditLog {
  id        String   @id @default(cuid())
  /// Ai làm. Giữ cả email tại thời điểm đó: tài khoản có thể bị xoá sau này,
  /// nhật ký thì phải đọc được mãi.
  actorId    String?
  actorEmail String
  /// create | update | delete | verify | role_change | disable | enable
  action     String
  /// Tên bảng/thực thể: pathology, structure, user...
  entity     String
  entityId   String
  /// Nhãn dễ đọc để danh sách nhật ký không phải join tới bảng gốc.
  entityLabel String?
  /// Ảnh chụp bản ghi TRƯỚC khi sửa; null với hành động tạo mới.
  before     Json?
  /// Phần dữ liệu đã gửi lên; null với hành động xoá.
  after      Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}
